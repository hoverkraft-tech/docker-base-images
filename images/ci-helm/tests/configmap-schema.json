{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["apiVersion", "kind", "metadata", "data"],
	"properties": {
		"apiVersion": { "const": "v1" },
		"kind": { "const": "ConfigMap" },
		"metadata": {
			"type": "object",
			"required": ["name"],
			"properties": { "name": { "type": "string" } }
		},
		"data": {
			"type": "object",
			"additionalProperties": { "type": "string" }
		}
	}
}
